# Vorlage für die lokale Konfiguration.
# Kopieren nach .env.local und mit eigenen Werten füllen:  cp .env.example .env.local
# .env.local wird von Git ignoriert – echte Schlüssel gehören NIE in dieses Repository.

# --- Supabase -------------------------------------------------------------
# Lokal: Werte aus `npx supabase status` (API URL, anon key, service_role key).
# Produktion: Supabase-Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig verwendet (Buchungsportal, Cron-Jobs). Niemals im Browser verwenden.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (KI-Antwortentwürfe, Bewertungsanalyse) -------------------
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# --- Google OAuth (Gmail-Anbindung) ---------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth-Client (Web).
# Autorisierte Weiterleitungs-URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NextAuth --------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Zufallswert, z. B. erzeugt mit:  openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Verschlüsselung gespeicherter OAuth-Tokens ----------------------------
# Muss exakt 32 Zeichen lang sein, z. B.:  openssl rand -hex 16
ENCRYPTION_KEY=

# --- Cron-Endpunkt (E-Mail-Synchronisation) --------------------------------
# Gemeinsames Geheimnis für /api/cron/sync-emails (Vercel Cron sendet es als Bearer-Token).
CRON_SECRET=

# --- Optional: Dev-Server im lokalen WLAN (Tablet/Handy) -------------------
# Lokale IP-Adresse dieses Rechners, z. B. 192.168.0.10
DEV_ALLOWED_ORIGIN=
